<!DOCTYPE html>
<head>
    <title>Admin</title>
    <link rel="stylesheet" href="\css\common.css">
</head>
<body>
    <div class="search-container">
        <input type="text"
               id="searchInput"
               class="search-input"
               onkeypress="handleSearchKeypress(event)">
        <button onclick="searchItems()" class="search-button">
            Search
        </button>
        <button onclick="openModal()" class="item-button">
            Add
        </button>
    </div>

    <div id="itemsContainer" class="users-list">
        <p class="no-users">Loading items...</p>
    </div>

    <div id="itemModal" class="modal">
        <div class="modal-content">
            <span class="close" onclick="closeModal()">&times;</span>
            <form id="itemForm">
                <input type="text" id="Name" placeholder="Name" required>
                <textarea id="Info" placeholder="Info"></textarea>

                <select id="BuildingId" required>
                    <option value="" disabled selected>Loading buildings...</option>
                </select>

                <select id="RoomId" required disabled>
                    <option value="" disabled selected>Select building first</option>
                </select>

                <button type="button" onclick="createItem()">Save</button>
            </form>
        </div>
    </div>

    <script src="\js\admin.js"></script>
</body>
</html>